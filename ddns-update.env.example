# Cloudflare DDNS Configuration
# ===============================
# Set file permissions to 600 after filling in values:
#   chmod 600 ddns-update.env
#
# How to obtain each value:
#   CF_API_TOKEN:   Cloudflare Dashboard → Profile → API Tokens →
#                     Create Token → Edit zone DNS (use template) →
#                     Zone Resources → Include → Specific zone → your domain
#   CF_ZONE_ID:     Cloudflare Dashboard → your domain → Overview →
#                     API section (right sidebar) → Zone ID
#   CF_RECORD_NAME: Full FQDN of the A record to update, e.g. vpn.yourdomain.com
#   STATE_FILE:     Optional. Path to store last known IP. Default: /var/lib/ddns-agent/last_ip

CF_API_TOKEN="your-cloudflare-api-token"
CF_ZONE_ID="your-zone-id"
CF_RECORD_NAME="vpn.example.com"
# STATE_FILE="/var/lib/ddns-agent/last_ip"
